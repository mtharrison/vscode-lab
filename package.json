{
  "name": "vscode-lab",
  "displayName": "Lab Test Explorer",
  "description": "Run and debug hapijs/lab tests with VS Code's native Test Explorer",
  "version": "2.0.1",
  "license": "BSD-3-Clause",
  "author": {
    "name": "Matt Harrison"
  },
  "publisher": "mtharrison",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtharrison/vscode-lab.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing"
  ],
  "keywords": [
    "lab",
    "hapijs",
    "test",
    "testing",
    "test explorer"
  ],
  "activationEvents": [
    "workspaceContains:**/node_modules/@hapi/lab",
    "workspaceContains:**/node_modules/lab",
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Lab Test Explorer",
      "properties": {
        "labTestExplorer.testMatch": {
          "type": "string",
          "default": "**/test/**/*.{js,ts}",
          "description": "Glob pattern to match test files"
        },
        "labTestExplorer.labPath": {
          "type": "string",
          "default": "",
          "description": "Path to lab executable (leave empty to use npx)"
        },
        "labTestExplorer.timeout": {
          "type": "number",
          "default": 30000,
          "description": "Test timeout in milliseconds"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest": "npm run compile",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.55.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^6.13.0"
  }
}
